pre_umount_final_image() {
    # This runs right before the image is finalized

# TODO: 
# DONE? - uInitrd is missing
# DONE? - change /etc/fstab for ubifs
#     		- /dev/ubi0_0 / ubifs defaults 0 1
# DONE? - Add ubi.mtd=5 to bootargs
# - get console output right 
# (keyboard is not working - NOT SOLVED HERE)

    display_alert "[SWUPDATE_IMG_GEN]" "Installing mtd-utils for SWUpdate image generation" "info"
	apt update
	apt install -y mtd-utils 

 
	display_alert "[SWUPDATE_IMG_GEN]" "Working directory setup" "info"

	SWUGEN_CONFIG="$MOUNT/opt/swupdate-gen-image"
	SWUGEN_WORKDIR="$PWD/gen-swupdate-img"
	mkdir $SWUGEN_WORKDIR
	cd $SWUGEN_WORKDIR
	find $SWUGEN_CONFIG/
	cp -v $SWUGEN_CONFIG/* .	

    display_alert "[SWUPDATE_IMG_GEN]" "BACKUP files to modify temporarily" "info"
	MODIFIED_FILES="boot/armbianEnv.txt etc/fstab"
	(cd $MOUNT ; tar cfv $SWUGEN_WORKDIR/files_modified.tar $MODIFIED_FILES )

    display_alert "[SWUPDATE_IMG_GEN]" "Modify /etc/fstab to mount root on NAND ubifs in SWUpdate image" "info"
	sed -e 's/^UUID=.*/\/dev\/ubi0_0 \/ ubifs defaults 0 1/' -i $MOUNT/etc/fstab

	display_alert "[SWUPDATE_IMG_GEN]" "Modify /boot/armbianEnv.txt for NAND in SWUpdate image" "info"
	sed -e 's/^rootdev=.*/rootdev=ubi0:rootfs/' -e 's/^rootfstyp.*/rootfstype=ubifs/' -i $MOUNT/boot/armbianEnv.txt

    display_alert "[SWUPDATE_IMG_GEN]" "Contents of files modified to support booting from NAND storage:" "info"
	for f in $MODIFIED_FILES ;do

		echo
		echo #####################################
		echo "$f:"
		echo #####################################
   		cat  "$MOUNT/$f"
		echo #####################################
		echo
	
	done
	
    display_alert "[SWUPDATE_IMG_GEN]" "SWUpdate image generation [1] : mkfs.ubifs( \$MOUNT ) -> rootfs.ubifs" "info"
	mkfs.ubifs -q -r "$MOUNT" -m 16384 -e 2064384 -c 2048 -o rootfs.ubifs

    display_alert "[SWUPDATE_IMG_GEN]" "SWUpdate image generation [2] : ubinize( rootfs.ubifs, ... ) -> rootfs.ubi" "info"
	#gen_ubinize-rootfs-config
    #ubinize -o rootfs.ubi -m 2048 -p 128KiB -s 2048 ubinize-rootfs.cfg

	FILES="sw-description installscript.sh rootfs.ubifs"

	IMAGE_FILENAME="${calculated_image_version}.swu"
	IMAGE_PATH="$DEST/images"
	IMAGE_PATHNAME="${IMAGE_PATH}/${IMAGE_FILENAME}"
    display_alert "[SWUPDATE_IMG_GEN]" "SWUpdate image generation: cpio( rootfs.ubifs , ... ) -> $IMAGE_PATHNAME" "info"
	for i in $FILES;do
		echo $i;done | cpio -ov -H crc > $IMAGE_PATHNAME
	( cd ${IMAGE_PATH} ; sha256sum ${IMAGE_FILENAME} > ${IMAGE_FILENAME}.sha )
	
    display_alert "[SWUPDATE_IMG_GEN]" "RESTORE modified files to their original contents" "info"
	tar xfv "$SWUGEN_WORKDIR/files_modified.tar" -C "$MOUNT"
    
    display_alert "[SWUPDATE_IMG_GEN]" "SWUpdate image generated. Cleaning up..." "info"
	rm -rv "$SWUGEN_WORKDIR" "$SWUGEN_CONFIG"

    display_alert "[SWUPDATE_IMG_GEN]" "Restored original contents of files supporting booting from USB storage:" "info"
	for f in $MODIFIED_FILES ;do

		echo
		echo #####################################
		echo "$f:"
		echo #####################################
   		cat  "$MOUNT/$f"
		echo #####################################
		echo
	
	done

}

