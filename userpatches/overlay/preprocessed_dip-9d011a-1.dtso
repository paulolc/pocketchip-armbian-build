# 0 "dip-9d011a-1.dts"
# 0 "<built-in>"
# 0 "<command-line>"
# 1 "dip-9d011a-1.dts"
/dts-v1/;
/plugin/;
# 1 "./dt-bindings/pwm/pwm.h" 1
# 4 "dip-9d011a-1.dts" 2
# 1 "./dt-bindings/interrupt-controller/irq.h" 1
# 5 "dip-9d011a-1.dts" 2
# 1 "./dt-bindings/input/input.h" 1
# 13 "./dt-bindings/input/input.h"
# 1 "./dt-bindings/input/linux-event-codes.h" 1
# 14 "./dt-bindings/input/input.h" 2
# 6 "dip-9d011a-1.dts" 2

/ {
 compatible = "nextthing,chip", "allwinner,sun5i-r8", "allwinner,sun5i-a13";

 fragment@0{
  target-path = "/";

  __overlay__ {
   backlight: backlight {
    compatible = "pwm-backlight";
    pwms = <&pwm 0 8000 (1 << 0)>;
    power-supply = <&reg_vcc3v3>;
    brightness-levels = <0 1 2 4 8 12 16 24 28 32 100>;
    default-brightness-level = <8>;
    enable-gpios = <&pio 3 18 0>;
   };

   panel {
    power-supply = <&reg_vcc3v3>;
    compatible = "olimex,lcd-olinuxino-43-ts";
    backlight = <&backlight>;

    port {
     panel_input: endpoint {
      remote-endpoint = <&tcon0_out_panel>;
     };
    };
   };
  };
 };

 fragment@1{
  target = <&i2c1>;

  __overlay__ {
   status = "okay";

   keyboard: keyboard@34 {
    compatible = "ti,tca8418";
    reg = <0x34>;
    interrupt-parent = <&pio>;
    interrupts = <6 1 2>;
    keypad,num-rows = <6>;
    keypad,num-columns = <10>;
    keypad,autorepeat;
    1,keymap = <
     ((((0) & 0xFF) << 24) | (((0) & 0xFF) << 16) | ((13) & 0xFFFF))
     ((((0) & 0xFF) << 24) | (((1) & 0xFF) << 16) | ((2) & 0xFFFF))
     ((((0) & 0xFF) << 24) | (((2) & 0xFF) << 16) | ((3) & 0xFFFF))
     ((((0) & 0xFF) << 24) | (((3) & 0xFF) << 16) | ((4) & 0xFFFF))
     ((((0) & 0xFF) << 24) | (((4) & 0xFF) << 16) | ((5) & 0xFFFF))
     ((((0) & 0xFF) << 24) | (((5) & 0xFF) << 16) | ((6) & 0xFFFF))
     ((((0) & 0xFF) << 24) | (((6) & 0xFF) << 16) | ((7) & 0xFFFF))
     ((((0) & 0xFF) << 24) | (((7) & 0xFF) << 16) | ((8) & 0xFFFF))
     ((((0) & 0xFF) << 24) | (((8) & 0xFF) << 16) | ((9) & 0xFFFF))
     ((((0) & 0xFF) << 24) | (((9) & 0xFF) << 16) | ((10) & 0xFFFF))
     ((((1) & 0xFF) << 24) | (((0) & 0xFF) << 16) | ((16) & 0xFFFF))
     ((((1) & 0xFF) << 24) | (((1) & 0xFF) << 16) | ((17) & 0xFFFF))
     ((((1) & 0xFF) << 24) | (((2) & 0xFF) << 16) | ((18) & 0xFFFF))
     ((((1) & 0xFF) << 24) | (((3) & 0xFF) << 16) | ((19) & 0xFFFF))
     ((((1) & 0xFF) << 24) | (((4) & 0xFF) << 16) | ((20) & 0xFFFF))
     ((((1) & 0xFF) << 24) | (((5) & 0xFF) << 16) | ((21) & 0xFFFF))
     ((((1) & 0xFF) << 24) | (((6) & 0xFF) << 16) | ((22) & 0xFFFF))
     ((((1) & 0xFF) << 24) | (((7) & 0xFF) << 16) | ((23) & 0xFFFF))
     ((((1) & 0xFF) << 24) | (((8) & 0xFF) << 16) | ((24) & 0xFFFF))
     ((((1) & 0xFF) << 24) | (((9) & 0xFF) << 16) | ((25) & 0xFFFF))
     ((((2) & 0xFF) << 24) | (((0) & 0xFF) << 16) | ((30) & 0xFFFF))
     ((((2) & 0xFF) << 24) | (((1) & 0xFF) << 16) | ((31) & 0xFFFF))
     ((((2) & 0xFF) << 24) | (((2) & 0xFF) << 16) | ((32) & 0xFFFF))
     ((((2) & 0xFF) << 24) | (((3) & 0xFF) << 16) | ((33) & 0xFFFF))
     ((((2) & 0xFF) << 24) | (((4) & 0xFF) << 16) | ((34) & 0xFFFF))
     ((((2) & 0xFF) << 24) | (((5) & 0xFF) << 16) | ((35) & 0xFFFF))
     ((((2) & 0xFF) << 24) | (((6) & 0xFF) << 16) | ((36) & 0xFFFF))
     ((((2) & 0xFF) << 24) | (((7) & 0xFF) << 16) | ((37) & 0xFFFF))
     ((((2) & 0xFF) << 24) | (((8) & 0xFF) << 16) | ((38) & 0xFFFF))
     ((((2) & 0xFF) << 24) | (((9) & 0xFF) << 16) | ((28) & 0xFFFF))
     ((((3) & 0xFF) << 24) | (((0) & 0xFF) << 16) | ((15) & 0xFFFF))
     ((((3) & 0xFF) << 24) | (((1) & 0xFF) << 16) | ((44) & 0xFFFF))
     ((((3) & 0xFF) << 24) | (((2) & 0xFF) << 16) | ((45) & 0xFFFF))
     ((((3) & 0xFF) << 24) | (((3) & 0xFF) << 16) | ((46) & 0xFFFF))
     ((((3) & 0xFF) << 24) | (((4) & 0xFF) << 16) | ((47) & 0xFFFF))
     ((((3) & 0xFF) << 24) | (((5) & 0xFF) << 16) | ((48) & 0xFFFF))
     ((((3) & 0xFF) << 24) | (((6) & 0xFF) << 16) | ((49) & 0xFFFF))
     ((((3) & 0xFF) << 24) | (((7) & 0xFF) << 16) | ((50) & 0xFFFF))
     ((((3) & 0xFF) << 24) | (((8) & 0xFF) << 16) | ((103) & 0xFFFF))
     ((((3) & 0xFF) << 24) | (((9) & 0xFF) << 16) | ((108) & 0xFFFF))
     ((((4) & 0xFF) << 24) | (((0) & 0xFF) << 16) | ((1) & 0xFFFF))
     ((((4) & 0xFF) << 24) | (((1) & 0xFF) << 16) | ((100) & 0xFFFF))
     ((((4) & 0xFF) << 24) | (((2) & 0xFF) << 16) | ((56) & 0xFFFF))
     ((((4) & 0xFF) << 24) | (((3) & 0xFF) << 16) | ((57) & 0xFFFF))
     ((((4) & 0xFF) << 24) | (((4) & 0xFF) << 16) | ((97) & 0xFFFF))
     ((((4) & 0xFF) << 24) | (((5) & 0xFF) << 16) | ((53) & 0xFFFF))
     ((((4) & 0xFF) << 24) | (((6) & 0xFF) << 16) | ((54) & 0xFFFF))
     ((((4) & 0xFF) << 24) | (((8) & 0xFF) << 16) | ((105) & 0xFFFF))
     ((((4) & 0xFF) << 24) | (((9) & 0xFF) << 16) | ((106) & 0xFFFF))
     ((((5) & 0xFF) << 24) | (((0) & 0xFF) << 16) | ((42) & 0xFFFF))
     ((((5) & 0xFF) << 24) | (((1) & 0xFF) << 16) | ((11) & 0xFFFF))
     ((((5) & 0xFF) << 24) | (((2) & 0xFF) << 16) | ((12) & 0xFFFF))
     ((((5) & 0xFF) << 24) | (((3) & 0xFF) << 16) | ((14) & 0xFFFF))
     ((((5) & 0xFF) << 24) | (((4) & 0xFF) << 16) | ((52) & 0xFFFF))
    >;
   };
  };
 };

        fragment@2{
                target = <&i2c1_pins>;

                __overlay__ {
   drive-strength = <10>;
   bias-disable;
  };
 };

 fragment@3{
  target = <&lcd_rgb565_pins>;

  __overlay__ {
   drive-strength = <10>;
   bias-disable;
  };
 };

 fragment@4{
  target = <&pwm>;

  __overlay__ {
   pinctrl-names = "default";
   pinctrl-0 = <&pwm0_pin>;
   status = "okay";
  };
 };

 fragment@5{
  target = <&pwm0_pin>;

  __overlay__ {
   drive-strength = <10>;
   bias-disable;
  };
 };

 fragment@6{
  target = <&rtp>;

  __overlay__ {
   allwinner,ts-attached;
  };
 };

 fragment@7{
  target = <&tcon0>;

  __overlay__ {
   pinctrl-names = "default";
   pinctrl-0 = <&lcd_rgb565_pins>;
  };
 };

 fragment@8{
  target = <&tcon0_out>;

  __overlay__ {
   tcon0_out_panel: endpoint@0 {
    reg = <0>;
    remote-endpoint = <&panel_input>;
    allwinner,tcon-channel = <0>;
   };
  };
 };
};
